{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test": "bun test tests/unit",
    "db:up": "bun src/infrastructure/persistence/migrate.ts up",
    "db:down": "bun src/infrastructure/persistence/migrate.ts down",
    "test:integration": "bun test tests/integration",
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json",
    "test:load": "bun scripts/load.ts",
    "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@aws-sdk/client-sqs": "3.1155.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "prettier": "3.6.2"
  },
  "packageManager": "bun@1.4.3"
}
